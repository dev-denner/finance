{
  "name": "finance-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:backup": "tsx src/db/backup-cli.ts",
    "db:reset:data": "tsx src/db/reset-cli.ts data",
    "db:reset:all": "tsx src/db/reset-cli.ts all",
    "db:restore": "tsx src/db/restore-cli.ts",
    "db:studio": "drizzle-kit studio",
    "reminders:run": "node --env-file-if-exists=../.env --import tsx src/services/bill-reminder-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.4.0",
    "nodemailer": "^10.2.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
